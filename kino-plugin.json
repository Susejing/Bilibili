{
  "id": "bilibili",
  "name": "Bilibili",
  "version": "1.6.4",
  "apiVersion": 23,
  "entry": "plugin.js",
  "description": "Bilibili China: catálogo, búsqueda, cuenta, subtítulos y reproducción. MD5 puro.",
  "author": "Susejing",
  "homepage": "https://github.com/Susejing/kino-plugin-bilibili",
  "hosts": [
    "api.bilibili.com",
    "www.bilibili.com",
    "*.bilibili.com",
    "*.bilivideo.com",
    "passport.bilibili.com"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "resolve",
    "subtitles",
    "playlists",
    "download",
    "scopedSearch"
  ],
  "resolveAhead": true,
  "visualBrowser": true,
  "browser": "pages",
  "categories": [
    "anime",
    "movies",
    "series"
  ],
  "color": "#FB7299",
  "debug": false,
  "settings": [
    {
      "key": "link_account",
      "label": "Vincular cuenta (Navegador)",
      "type": "action"
    },
    {
      "key": "verify_account",
      "label": "Verificar Cuenta",
      "type": "action"
    },
    {
      "key": "sessdata",
      "label": "Cookie SESSDATA",
      "type": "password",
      "hint": "Se llena automáticamente."
    },
    {
      "key": "dedeuserid",
      "label": "Cookie DedeUserID",
      "type": "text",
      "hint": "Se llena automáticamente."
    },
    {
      "key": "bili_jct",
      "label": "Cookie bili_jct",
      "type": "password",
      "hint": "Se llena automáticamente."
    }
  ]
}
