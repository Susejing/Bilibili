{
  "id": "bilibili",
  "name": "Bilibili",
  "version": "0.8.2",
  "apiVersion": 20,
  "entry": "plugin.js",
  "description": "Bilibili internacional y China con soporte para inicio de sesión, historial y favoritos.",
  "author": "Susejing",
  "homepage": "https://github.com/Susejing/kino-plugin-bilibili",
  "hosts": [
    "api.bilibili.com",
    "www.bilibili.com",
    "*.bilibili.com",
    "*.bilivideo.com",
    "api.bilibili.tv",
    "www.bilibili.tv",
    "*.bilibili.tv",
    "*.akamaized.net",
    "passport.bilibili.com"
  ],
  "streamHosts": "any",
  "capabilities": ["search", "home", "browse", "episodes", "resolve"],
  "browser": "pages",
  "visualBrowser": true,
  "color": "#FB7299",
  "categories": ["anime", "movies", "series"],
  "debug": true,
  "settings": [
    {
      "key": "region",
      "label": "Versión",
      "type": "select",
      "default": "intl",
      "options": [
        { "value": "intl", "label": "Internacional (sin VPN)" },
        { "value": "china", "label": "China (con VPN)" }
      ],
      "hint": "Internacional usa bilibili.tv. China usa bilibili.com y suele requerir VPN."
    },
    {
      "key": "link_account",
      "label": "Vincular cuenta de Bilibili (China)",
      "type": "action"
    },
    {
      "key": "sessdata",
      "label": "Cookie SESSDATA (o pegar a mano)",
      "type": "password",
      "hint": "Opcional. Se llena automáticamente al vincular la cuenta."
    }
  ]
}
