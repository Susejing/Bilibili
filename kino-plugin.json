{
  "id": "bilibili",
  "name": "Bilibili",
  "version": "1.0.8",
  "apiVersion": 23,
  "entry": "plugin.js",
  "description": "Bilibili con Historial, Favoritos, Trakt, Descargas, Temas y múltiples secciones.",
  "author": "Susejing",
  "homepage": "https://github.com/Susejing/kino-plugin-bilibili",
  "hosts": [
    "api.bilibili.com",
    "www.bilibili.com",
    "*.bilibili.com",
    "*.bilivideo.com",
    "api.bilibili.tv",
    "www.bilibili.tv",
    "*.bilibili.tv",
    "*.akamaized.net",
    "passport.bilibili.com"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search", "home", "browse", "episodes", "resolve", 
    "subtitles", "segments", "tracking", "playlists", 
    "download", "scopedSearch"
  ],
  "visualBrowser": true,
  "browser": "pages",
  "categories": ["anime", "movies", "series"],
  "color": "#FB7299",
  "debug": true,
  "settings": [
    {
      "key": "region",
      "label": "Versión",
      "type": "select",
      "default": "intl",
      "options": [
        { "value": "intl", "label": "Internacional" },
        { "value": "china", "label": "China" }
      ],
      "hint": "China suele requerir VPN."
    },
    {
      "key": "link_account",
      "label": "Vincular cuenta (Usuario/Contraseña)",
      "type": "action"
    },
    {
      "key": "qr_login",
      "label": "Vincular cuenta (Código QR)",
      "type": "action"
    },
    {
      "key": "sessdata",
      "label": "Cookie SESSDATA",
      "type": "password",
      "hint": "Se llena automáticamente."
    },
    {
      "key": "trakt_sync",
      "label": "Sincronizar con Trakt",
      "type": "toggle",
      "default": true
    }
  ]
}
