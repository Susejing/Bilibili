{
  "id": "bilibili",
  "name": "Bilibili",
  "version": "1.0.2",
  "apiVersion": 23,
  "entry": "plugin.js",
  "description": "Bilibili internacional y China con integración total: Historial, Favoritos, Trakt, Descargas, Temas y más.",
  "author": "Susejing",
  "homepage": "https://github.com/Susejing/kino-plugin-bilibili",
  "hosts": [
    "api.bilibili.com",
    "www.bilibili.com",
    "*.bilibili.com",
    "*.bilivideo.com",
    "api.bilibili.tv",
    "www.bilibili.tv",
    "*.bilibili.tv",
    "*.akamaized.net",
    "passport.bilibili.com"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search", "home", "browse", "episodes", "resolve", 
    "subtitles", "segments", "track", "lists", 
    "download", "scopedSearch", "categories"
  ],
  "browser": "pages",
  "visualBrowser": true,
  "color": "#FB7299",
  "categories": ["anime", "movies", "series"],
  "debug": true,
  "settings": [
    {
      "key": "region",
      "label": "Versión",
      "type": "select",
      "default": "intl",
      "options": [
        { "value": "intl", "label": "Internacional (sin VPN)" },
        { "value": "china", "label": "China (con VPN)" }
      ],
      "hint": "Internacional usa bilibili.tv. China usa bilibili.com."
    },
    {
      "key": "link_account",
      "label": "Vincular cuenta de Bilibili (China)",
      "type": "action"
    },
    {
      "key": "sessdata",
      "label": "Cookie SESSDATA (o pegar a mano)",
      "type": "password",
      "hint": "Opcional."
    },
    {
      "key": "trakt_sync",
      "label": "Sincronizar con Trakt",
      "type": "toggle",
      "default": true
    }
  ]
}
